            "dataType": "double",
            "sourceColumn": "unrecorded_rate",
            "formatString": "0.0%"
          },
          {
            "name": "overtime_share",
            "dataType": "double",
            "sourceColumn": "overtime_share",
            "formatString": "0.0%"
          },
          {
            "name": "revenue_czk",
            "dataType": "double",
            "sourceColumn": "revenue_czk",
            "formatString": "#,0"
          },
          {
            "name": "labor_cost_czk",
            "dataType": "double",
            "sourceColumn": "labor_cost_czk",
            "formatString": "#,0"
          },
          {
            "name": "gross_margin_czk",
            "dataType": "double",
            "sourceColumn": "gross_margin_czk",
            "formatString": "#,0"
          },
          {
