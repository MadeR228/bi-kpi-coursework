            "dataType": "int64",
            "sourceColumn": "trips_cancelled",
            "formatString": "#,0"
          },
          {
            "name": "on_time_rate",
            "dataType": "double",
            "sourceColumn": "on_time_rate",
            "formatString": "0.0%"
          },
          {
            "name": "avg_delay_min",
            "dataType": "double",
            "sourceColumn": "avg_delay_min",
            "formatString": "#,0.0"
          },
          {
            "name": "seat_occupancy",
            "dataType": "double",
            "sourceColumn": "seat_occupancy",
            "formatString": "0.0%"
          },
          {
            "name": "boarding_rate",
            "dataType": "double",
            "sourceColumn": "boarding_rate",
