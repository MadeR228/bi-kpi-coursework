          }
        ],
        "partitions": [
          {
            "name": "KPI місяць",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = PostgreSQL.Database(Server, Database),\n    Data = Source{[Schema=\"mart\",Item=\"kpi_workplace_month\"]}[Data]\nin\n    Data"
            }
          }
        ],
        "measures": [
          {
            "name": "Прийнято",
            "expression": "SUM('KPI місяць'[hires])",
            "formatString": "#,0"
          },
          {
            "name": "Звільнилось",
            "expression": "SUM('KPI місяць'[leavers])",
            "formatString": "#,0"
          },
          {
            "name": "Плинність за місяць",
            "expression": "DIVIDE([Звільнилось], SUM('KPI місяць'[avg_headcount]))",
            "formatString": "0.0%"
          },
          {
            "name": "Виставлено рахунків",
            "expression": "SUM('KPI місяць'[invoiced_czk])",
            "formatString": "#,0"
          },
          {
            "name": "Розбіжність з рахунками",
            "expression": "VAR billed = FILTER('KPI місяць', NOT ISBLANK('KPI місяць'[invoiced_czk])) RETURN DIVIDE(SUMX(billed, 'KPI місяць'[invoiced_czk]) - SUMX(billed, 'KPI місяць'[revenue_czk]), SUMX(billed, 'KPI місяць'[revenue_czk]))",
            "formatString": "0.0%"
          },
          {
            "name": "Медіана рішення, год",
            "expression": "AVERAGE('KPI місяць'[median_decision_hours])",
            "formatString": "#,0.0"
          }
        ]
      },
