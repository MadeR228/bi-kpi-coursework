          }
        ],
        "partitions": [
          {
            "name": "KPI день",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = PostgreSQL.Database(Server, Database),\n    Data = Source{[Schema=\"mart\",Item=\"kpi_workplace_day\"]}[Data]\nin\n    Data"
            }
          }
        ],
        "measures": [
          {
            "name": "Години план",
            "expression": "CALCULATE(SUM('KPI день'[planned_hours]), 'KPI день'[is_future] = FALSE())",
            "formatString": "#,0"
          },
          {
            "name": "Години факт",
            "expression": "SUM('KPI день'[worked_hours])",
            "formatString": "#,0"
          },
          {
            "name": "Виконання плану",
            "expression": "DIVIDE([Години факт], [Години план])",
            "formatString": "0.0%"
          },
          {
            "name": "Заплановані зміни",
            "expression": "CALCULATE(SUM('KPI день'[planned_shifts]), 'KPI день'[is_future] = FALSE())",
            "formatString": "#,0"
          },
          {
            "name": "Невиходи",
            "expression": "DIVIDE(SUMX('KPI день', 'KPI день'[no_show_rate] * 'KPI день'[planned_shifts]), [Заплановані зміни])",
            "formatString": "0.0%"
          },
          {
            "name": "Лікарняні",
            "expression": "DIVIDE(SUMX('KPI день', 'KPI день'[sick_rate] * 'KPI день'[planned_shifts]), [Заплановані зміни])",
            "formatString": "0.0%"
          },
          {
            "name": "Понаднормові",
            "expression": "DIVIDE(SUM('KPI день'[overtime_hours]), [Години факт])",
            "formatString": "0.0%"
          },
          {
            "name": "Середня чисельність",
            "expression": "AVERAGEX(VALUES('Календар'[date]), CALCULATE(SUM('KPI день'[headcount])))",
            "formatString": "#,0"
          },
          {
            "name": "Виручка",
            "expression": "SUM('KPI день'[revenue_czk])",
            "formatString": "#,0"
          },
          {
            "name": "Витрати на персонал",
            "expression": "SUM('KPI день'[labor_cost_czk])",
            "formatString": "#,0"
          },
          {
            "name": "Валова маржа",
            "expression": "[Виручка] - [Витрати на персонал]",
            "formatString": "#,0"
          },
          {
            "name": "Маржа %",
            "expression": "DIVIDE([Валова маржа], [Виручка])",
            "formatString": "0.0%"
          },
          {
            "name": "Маржа % мин. рік",
            "expression": "CALCULATE([Маржа %], SAMEPERIODLASTYEAR('Календар'[date]))",
            "formatString": "0.0%"
          },
          {
            "name": "Виручка зміна р/р",
            "expression": "VAR ly = CALCULATE([Виручка], SAMEPERIODLASTYEAR('Календар'[date])) RETURN DIVIDE([Виручка] - ly, ly)",
            "formatString": "0.0%"
          },
          {
            "name": "Рейси",
            "expression": "SUM('KPI день'[trips])",
            "formatString": "#,0"
          },
          {
            "name": "Скасовані рейси",
            "expression": "SUM('KPI день'[trips_cancelled])",
            "formatString": "#,0"
          },
          {
            "name": "Рейси вчасно",
            "expression": "DIVIDE(SUMX('KPI день', 'KPI день'[on_time_rate] * ('KPI день'[trips] - 'KPI день'[trips_cancelled])), SUMX(FILTER('KPI день', NOT ISBLANK('KPI день'[on_time_rate])), 'KPI день'[trips] - 'KPI день'[trips_cancelled]))",
            "formatString": "0.0%"
          },
          {
            "name": "Середня затримка, хв",
            "expression": "DIVIDE(SUMX('KPI день', 'KPI день'[avg_delay_min] * ('KPI день'[trips] - 'KPI день'[trips_cancelled])), SUMX(FILTER('KPI день', NOT ISBLANK('KPI день'[avg_delay_min])), 'KPI день'[trips] - 'KPI день'[trips_cancelled]))",
            "formatString": "#,0.0"
          },
          {
            "name": "Заповненість автобусів",
            "expression": "AVERAGE('KPI день'[seat_occupancy])",
            "formatString": "0.0%"
          },
          {
            "name": "Факт за 120 днів",
            "expression": "VAR lastDay = CALCULATE(MAX('KPI день'[date]), ALL('KPI день'), 'KPI день'[is_future] = FALSE()) VAR d = MAX('Календар'[date]) RETURN IF(d > lastDay - 120 && d <= lastDay, [Години факт])",
            "formatString": "#,0"
          }
        ]
      },
